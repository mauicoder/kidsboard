<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Application theme using MaterialComponents -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>
        <item name="colorAccent">@color/orange</item>
    </style>

    <!-- Dialog style -->
    <style name="ColorDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowAnimationStyle">@style/ColorDialogAnimation</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ColorDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/incoming</item>
        <item name="android:windowExitAnimation">@anim/outgoing</item>
    </style>

</resources>
