<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="@dimen/color_swatch_margin">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSwatch"
        android:layout_width="@dimen/color_swatch_size"
        android:layout_height="@dimen/color_swatch_size"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:cornerRadius="@dimen/color_swatch_corner_radius"
        app:strokeColor="@color/color_swatch_stroke"
        app:strokeWidth="@dimen/color_swatch_stroke_width"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp" />

</FrameLayout>
